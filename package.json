{
  "name": "overblaster",
  "version": "0.1.0",
  "description": "OverBlaster by OverLord Labs: a head-aimed, voice-fired space shooter. Embeddable, framework-free TypeScript.",
  "type": "module",
  "license": "UNLICENSED",
  "private": true,
  "main": "./dist/lib/overblaster.umd.cjs",
  "module": "./dist/lib/overblaster.js",
  "types": "./dist/lib/index.d.ts",
  "exports": {
    ".": { "types": "./dist/lib/index.d.ts", "import": "./dist/lib/overblaster.js", "require": "./dist/lib/overblaster.umd.cjs" }
  },
  "files": ["dist", "public/audio", "public/logo.png"],
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "build": "npm run typecheck && vite build && vite build --config vite.lib.config.ts && tsc -p tsconfig.build.json",
    "build:single": "node scripts/build-single.mjs",
    "sim": "tsx scripts/sim.ts"
  },
  "devDependencies": {
    "tsx": "^4.19.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10",
    "vitest": "^2.1.4"
  }
}
